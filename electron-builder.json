{
  "appId": "com.kerrambit.molstarapp",
  "files": ["dist-electron", "dist-react"],
  "extraResources": ["dist-electron/preload.cjs", "src/assets/**", "src/locales/**", {
        "from": "dist-server/",
        "to": ".",
        "filter": "MolStarAppServer*"
      }],
  "icon": "./desktopIcon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Science"
  },
  "win": {
    "target": ["msi"]
  }
}