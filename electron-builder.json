{
  "appId": "com.kerrambit.molstarapp",
  "files": ["dist-electron", "dist-react"],
  "extraResources": ["dist-electron/preload.cjs", "src/assets/**", "src/locales/**", {
        "from": "dist-server/",
        "to": ".",
        "filter": "MolStarAppServer*"
      }],
  "icon": "./src/assets/desktopIcon.ico",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Science",
    "icon": "./src/assets/desktopIcon.png"
  },
  "win": {
    "target": ["msi"],
    "icon": "./src/assets/desktopIcon.ico"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "shortcutName": "MolStarApp",
    "createDesktopShortcut": false
  }
}