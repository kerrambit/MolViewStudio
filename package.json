{
  "name": "MolViewStudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run generate:buildinfo && npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5123 && npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "generate:buildinfo": "tsx scripts/generate-build-info.ts",
    "generate:api:schema": "tsx scripts/generate-api-schema.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:server": "pyinstaller --onefile src/server/main.py --name MolViewStudioServer --icon ../../src/assets/serverIcon.png --distpath ./dist-server --workpath ./tmp/server --specpath ./tmp/server",
    "build:server:uv": "uv run python -m PyInstaller --onefile src/server/main.py --name MolViewStudioServer --icon ../../src/assets/serverIcon.png --distpath ./dist-server --workpath ./tmp/server --specpath ./tmp/server",
    "server": "node scripts/run-server.ts",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:win": "npm run generate:buildinfo && npm run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run generate:buildinfo && npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "dist:mac": "npm run generate:buildinfo && npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "test:e2e": "playwright test",
    "test:unit": "vitest src"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/dropzone": "^9.1.1",
    "@mantine/form": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.9",
    "@zodios/core": "^10.9.6",
    "axios": "^1.18.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "i18next": "^26.0.10",
    "molstar": "^5.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "react-use-websocket": "^4.13.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "baseline-browser-mapping": "^2.10.29",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "openapi-zod-client": "^1.18.3",
    "postcss": "^8.5.14",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sass-embedded": "^1.99.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.6"
  }
}
