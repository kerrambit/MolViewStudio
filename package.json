{
  "name": "molstarapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5123 && npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:server": "pyinstaller --onefile src/server/main.py --name MolStarAppServer --distpath ./dist-server --workpath ./tmp/server --specpath ./tmp/server --clean",
    "server": "node scripts/run-server.ts",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "test:e2e": "playwright test",
    "test:unit": "vitest src"
  },
  "dependencies": {
    "@mantine/core": "^8.2.7",
    "@mantine/dropzone": "^8.3.1",
    "@mantine/form": "^8.2.7",
    "@mantine/hooks": "^8.2.7",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.85.6",
    "electron-log": "^5.4.3",
    "i18next": "^25.3.2",
    "molstar-wrapper": "file:src/molstar-wrapper",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "baseline-browser-mapping": "^2.9.18",
    "cross-env": "^10.0.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.4.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "overrides": {
    "electron-builder": "$electron-builder",
    "tar": "^7.5.3",
    "minimatch": "^3.0.5",
    "got": "^11.8.5"
  }
}
